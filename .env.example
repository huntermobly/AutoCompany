# Example only. The application reads process environment, not .env automatically.
COMPLIANCE_DB=.local/compliance.sqlite3
COMPLIANCE_MODE=development
SANDBOX_ENV=test
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# External integrations stay off until explicitly enabled by the operator.
ENABLE_EXTERNAL_PROVIDERS=false
ALLOW_LIVE_TESTS=false

